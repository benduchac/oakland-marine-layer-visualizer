# Mapbox GL map + Terrain-RGB elevation. Get one at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# Identifies this app to api.weather.gov per their usage policy. Format:
# "(app-name, contact-info)". Optional — falls back to a generic value.
NWS_USER_AGENT=

# Set by Vercel automatically when a Blob store is attached to the project.
# Without it, cron routes fall back to writing JSON files under .data/ locally.
BLOB_READ_WRITE_TOKEN=

# Set this in Vercel project settings; Vercel Cron sends it automatically as
# an Authorization: Bearer header. Leave unset locally to allow manual
# invocation of the cron routes without auth.
CRON_SECRET=
